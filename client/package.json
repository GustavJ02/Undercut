{
  "name": "undercut-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/make-notices.mjs && node scripts/check-denylist.mjs --dist dist",
    "test": "vitest run",
    "contract": "UNDERCUT_CONTRACT_LIVE=1 vitest run src/contract",
    "mods:validate": "vite-node scripts/mods.ts validate",
    "mods:list": "vite-node scripts/mods.ts list",
    "mods:init": "vite-node scripts/mods.ts init",
    "notices": "node scripts/make-notices.mjs",
    "check:tree": "node scripts/check-denylist.mjs"
  },
  "dependencies": {
    "@types/three": "0.170.0",
    "ajv": "8.17.1",
    "pixi.js": "8.20.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-node": "2.1.9",
    "vitest": "^2.1.8"
  }
}
